# /etc/config/mwan3 – generated by Ansible
# Do not edit manually; re-run the deploy playbook instead.

# ============================================================
# Interface health tracking
# ============================================================

config interface 'wan'
    option enabled '1'
    list track_ip '{{ mwan3_ping_target }}'
    option track_method 'ping'
    option reliability '1'
    option count '1'
    option size '56'
    option timeout '{{ mwan3_ping_timeout }}'
    option interval '{{ mwan3_ping_interval }}'
    option failure_interval '{{ mwan3_ping_interval }}'
    option recovery_interval '{{ mwan3_ping_interval }}'
    option down '{{ mwan3_ping_failure_count }}'
    option up '{{ mwan3_ping_failure_count }}'

config interface 'wan2'
    option enabled '1'
    list track_ip '{{ mwan3_ping_target }}'
    option track_method 'ping'
    option reliability '1'
    option count '1'
    option size '56'
    option timeout '{{ mwan3_ping_timeout }}'
    option interval '{{ mwan3_ping_interval }}'
    option failure_interval '{{ mwan3_ping_interval }}'
    option recovery_interval '{{ mwan3_ping_interval }}'
    option down '{{ mwan3_ping_failure_count }}'
    option up '{{ mwan3_ping_failure_count }}'

# ============================================================
# Members – link weight inside a policy
# ============================================================

config member 'wan_m1_w{{ mwan3_vdsl_weight }}'
    option interface 'wan'
    option metric '1'
    option weight '{{ mwan3_vdsl_weight }}'

config member 'wan2_m1_w{{ mwan3_4g_weight }}'
    option interface 'wan2'
    option metric '1'
    option weight '{{ mwan3_4g_weight }}'

# ============================================================
# Policies
# ============================================================

# Weighted round-robin across both WANs
config policy 'balanced'
    list use_member 'wan_m1_w{{ mwan3_vdsl_weight }}'
    list use_member 'wan2_m1_w{{ mwan3_4g_weight }}'
    option last_resort 'default'

# Failover: prefer VDSL, fall back to 4G
config policy 'wan_only'
    list use_member 'wan_m1_w{{ mwan3_vdsl_weight }}'
    option last_resort 'default'

# Failover: prefer 4G, fall back to VDSL
config policy 'wan2_only'
    list use_member 'wan2_m1_w{{ mwan3_4g_weight }}'
    option last_resort 'default'

# ============================================================
# Rules
# ============================================================

{% if mwan3_sticky | default(false) %}
# HTTPS sticky rule — keep TLS sessions on the originating WAN
# to prevent mid-connection IP changes that break TLS.
config rule 'https_sticky'
    option dest_port '443'
    option proto 'tcp'
    option sticky '1'
    option use_policy 'balanced'
{% endif %}

# Default catch-all rule — all traffic uses the balanced policy
config rule 'default_rule'
    option dest_ip '0.0.0.0/0'
    option proto 'all'
{% if mwan3_sticky | default(false) %}
    option sticky '1'
{% endif %}
    option use_policy '{{ mwan3_policy }}'
