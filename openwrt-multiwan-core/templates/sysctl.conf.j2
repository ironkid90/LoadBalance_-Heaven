# /etc/sysctl.conf – generated by Ansible
# Do not edit manually; re-run the deploy playbook instead.

# ---------- IP forwarding (required for routing) ----------
net.ipv4.ip_forward=1

{% if enable_bbr | default(false) %}
# ---------- TCP BBR congestion control ----------
# fq (Fair Queue) is required as the default qdisc for BBR to work.
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control={{ tcp_congestion_control }}
{% endif %}

# ---------- Network performance tuning ----------
# Increase socket buffer sizes for higher throughput
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.ipv4.tcp_rmem=4096 87380 16777216
net.ipv4.tcp_wmem=4096 65536 16777216

# Enable TCP window scaling and timestamps
net.ipv4.tcp_window_scaling=1
net.ipv4.tcp_timestamps=1

# Reduce TIME_WAIT sockets for a busy NAT gateway
net.ipv4.tcp_fin_timeout=15
net.netfilter.nf_conntrack_tcp_timeout_time_wait=30

# Increase conntrack table size for many concurrent LAN clients
net.netfilter.nf_conntrack_max=32768
