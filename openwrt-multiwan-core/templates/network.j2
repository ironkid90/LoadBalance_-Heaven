# /etc/config/network – generated by Ansible
# Do not edit manually; re-run the deploy playbook instead.

config interface 'loopback'
    option device 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1'
    option netmask '255.0.0.0'

# ---------- LAN ----------
config interface 'lan'
    option device 'br-lan'
    option proto 'static'
    option ipaddr '{{ lan_ipaddr }}'
    option netmask '{{ lan_netmask }}'

# ---------- MACVLAN device ----------
# Creates a virtual Ethernet ({{ macvlan_pppoe_if }}) on top of
# {{ wan_vdsl_if }} so PPPoE can bind without conflicting with LAN bridge.
config device 'macvlan_dev'
    option type 'macvlan'
    option name '{{ macvlan_pppoe_if }}'
    option ifname '{{ wan_vdsl_if }}'
    option mode 'bridge'

# ---------- PPPoE WAN (VDSL) ----------
config interface 'wan'
    option device '{{ macvlan_pppoe_if }}'
    option proto 'pppoe'
    option username '{{ pppoe_username }}'
    option password '{{ pppoe_password }}'
    option mtu '{{ pppoe_mtu }}'
    option mru '{{ pppoe_mru }}'
    option ipv6 'auto'
    option keepalive '5 3'

# ---------- 4G USB WAN ----------
config interface 'wan2'
    option device '{{ wan_4g_if }}'
    option proto 'dhcp'
    option metric '20'
